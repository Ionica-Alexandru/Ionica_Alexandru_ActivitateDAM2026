<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/textView3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/apa"
        android:textSize="48sp"
        android:textStyle="bold"
        android:paddingLeft="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.085" />

        />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

    <TextView
        android:id="@+id/textView2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/brand"
        android:textSize="32sp"
        android:paddingLeft="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.11"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView3"
        app:layout_constraintVertical_bias="0.082" />

        <EditText
            android:id="@+id/brand_ET"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:paddingTop="20dp"
            android:paddingBottom="10dp"
            android:textSize="24dp"
            android:hint="@string/introdu_numele_brandului" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingVertical="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tip_apa"
            android:textSize="32sp"
            android:paddingLeft="10dp"
            />

        <Spinner
            android:id="@+id/tip_s"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/black"
            android:entries="@array/tipuri_apa"
            android:paddingLeft="30dp"
            android:scaleX="1.5"
            android:scaleY="1.5"
            android:spinnerMode="dropdown" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingVertical="10dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/volumul_sticlei"
            android:textSize="20sp"
            android:paddingTop="10dp"
            android:paddingLeft="5dp"
            />

        <RadioGroup
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:id="@+id/rb_group"
            >

        <RadioButton
            android:id="@+id/mili_300"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="@string/_330ml"
            android:layout_marginLeft="7dp"
            />

        <RadioButton
            android:id="@+id/mili_500"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="@string/_500ml"
            android:layout_marginLeft="7dp"
            />

        <RadioButton
            android:id="@+id/litri_1"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="@string/_1l"
            android:layout_marginLeft="7dp"
            />

        <RadioButton
            android:id="@+id/litri_2"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="@string/_2l"
            />
        </RadioGroup>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="10dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/pret_sticla"
            android:textSize="18sp"
            />

        <EditText
            android:id="@+id/pret_ET"
            android:layout_width="wrap_content"
            android:layout_height="64dp"
            android:hint="@string/introdu_pretul_sticlei"
            android:paddingBottom="10dp"
            />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingLeft="2dp"
            android:paddingRight="13dp"
            android:text="@string/ron"
            android:textSize="14sp" />

        <Switch
            android:id="@+id/switch1"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="Garantie cumparata"
            />

    </LinearLayout>

    <TextView
        android:layout_width="280dp"
        android:layout_height="wrap_content"
        android:text="@string/magazine_care_comercializeaza_sticla"
        android:textSize="32sp"
        android:paddingTop="10dp"
        android:paddingLeft="10dp"
        />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <CheckBox
            android:id="@+id/carreffour_cb"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="@string/carreffour"
            android:layout_marginLeft="5dp"
            />

        <CheckBox
            android:id="@+id/auchan_cb"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="@string/auchan"
            android:layout_marginLeft="10dp"
            />

        <CheckBox
            android:id="@+id/mega_cb"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="@string/mega_image"
            android:layout_marginLeft="10dp"
            />

        <CheckBox
            android:id="@+id/profi_cb"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="@string/profi"
            android:layout_marginLeft="10dp"
            />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <CheckBox
            android:id="@+id/kaufland_cb"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="@string/kaufland"
            android:layout_marginLeft="40dp"
            />

        <CheckBox
            android:id="@+id/lidl_cb"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="@string/lidl"
            android:layout_marginLeft="40dp"
            />

        <CheckBox
            android:id="@+id/lacocos_cb"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="@string/la_cocos"
            android:layout_marginLeft="40dp"
            />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/nota_utilizatori"
            android:textSize="24sp"
            android:paddingTop="20dp"
            android:paddingLeft="10dp"
            />

        <RatingBar
            android:id="@+id/nota_rb"
            android:layout_width="258dp"
            android:layout_height="wrap_content"
            android:paddingLeft="10dp"
            android:paddingTop="10dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="125dp"
        android:paddingTop="20dp">

        <Button
            android:id="@+id/button_adauga"
            android:layout_width="wrap_content"
            android:textAlignment="center"
            android:layout_height="wrap_content"
            android:text="@string/adauga_sticla"
            android:textSize="18sp" />

    </LinearLayout>
</LinearLayout>
