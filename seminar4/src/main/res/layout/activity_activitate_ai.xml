<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA"
    android:orientation="vertical"
    android:padding="16dp"
    tools:context=".MainActivity">

    <!-- TITLU PRINCIPAL -->
    <TextView
        android:id="@+id/textView3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:gravity="center"
        android:text="@string/apa"
        android:textColor="#1E293B"
        android:textSize="28sp"
        android:textStyle="bold" />

    <!-- BRAND -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/textView2"
            android:layout_width="80dp"
            android:layout_height="wrap_content"
            android:text="@string/brand"
            android:textColor="#334155"
            android:textSize="16sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/brand_ET"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="#E2E8F0"
            android:hint="@string/introdu_numele_brandului"
            android:inputType="textPersonName"
            android:paddingHorizontal="12dp"
            android:textSize="15sp" />
    </LinearLayout>

    <!-- TIP APA -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="80dp"
            android:layout_height="wrap_content"
            android:text="@string/tip_apa"
            android:textColor="#334155"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/tip_s"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="#E2E8F0"
            android:entries="@array/tipuri_apa"
            android:paddingHorizontal="8dp"
            android:spinnerMode="dropdown" />
    </LinearLayout>

    <!-- VOLUM -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="@string/volumul_sticlei"
            android:textColor="#334155"
            android:textSize="16sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rb_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/mili_300"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="@string/_330ml"
                android:textSize="13sp" />

            <RadioButton
                android:id="@+id/mili_500"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="@string/_500ml"
                android:textSize="13sp" />

            <RadioButton
                android:id="@+id/litri_1"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="@string/_1l"
                android:textSize="13sp" />

            <RadioButton
                android:id="@+id/litri_2"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="@string/_2l"
                android:textSize="13sp" />
        </RadioGroup>
    </LinearLayout>

    <!-- PRET SI GARANTIE -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/pret_sticla"
            android:textColor="#334155"
            android:textSize="16sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/pret_ET"
            android:layout_width="80dp"
            android:layout_height="48dp"
            android:layout_marginLeft="8dp"
            android:background="#E2E8F0"
            android:hint="0.0"
            android:inputType="numberDecimal"
            android:paddingHorizontal="8dp"
            android:textSize="15sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:text="@string/ron"
            android:textColor="#64748B"
            android:textSize="14sp" />

        <Switch
            android:id="@+id/switch1"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginLeft="12dp"
            android:text="Garanție"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- MAGAZINE -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="@string/magazine_care_comercializeaza_sticla"
            android:textColor="#334155"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <CheckBox
                android:id="@+id/carreffour_cb"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="@string/carreffour"
                android:textSize="12sp" />

            <CheckBox
                android:id="@+id/auchan_cb"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="@string/auchan"
                android:textSize="12sp" />

            <CheckBox
                android:id="@+id/mega_cb"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="@string/mega_image"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <CheckBox
                android:id="@+id/profi_cb"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="@string/profi"
                android:textSize="12sp" />

            <CheckBox
                android:id="@+id/kaufland_cb"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="@string/kaufland"
                android:textSize="12sp" />

            <CheckBox
                android:id="@+id/lidl_cb"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="@string/lidl"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <CheckBox
                android:id="@+id/lacocos_cb"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="@string/la_cocos"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- NOTA / RATING -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/nota_utilizatori"
            android:textColor="#334155"
            android:textSize="16sp"
            android:textStyle="bold" />

        <RatingBar
            android:id="@+id/nota_rb"
            style="?android:attr/ratingBarStyleIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:isIndicator="false"
            android:numStars="5"
            android:stepSize="0.5" />
    </LinearLayout>

    <!-- BUTON ADAUGARE -->
    <Button
        android:id="@+id/button_adauga"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="8dp"
        android:backgroundTint="#2563EB"
        android:text="@string/adauga_sticla"
        android:textColor="#FFFFFF"
        android:textSize="16sp" />

</LinearLayout>